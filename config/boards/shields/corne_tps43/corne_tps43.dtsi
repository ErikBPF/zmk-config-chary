#include <dt-bindings/zmk/matrix_transform.h>
#include <input/processors.dtsi>
#include <input/processors/code_mapper.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include "../../../charybdis_parameters.h"

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)  RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                        RC(3,3) RC(3,4) RC(3,5)  RC(3,6) RC(3,7) RC(3,8)
        >;
    };

    kscan0: kscan {
        diode-direction = "col2row";
    };

    splits {
        #address-cells = <1>;
        #size-cells = <0>;

        touchpad_split: touchpad_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
            status = "disabled";
        };

        touchpad_right_split: touchpad_right_split@1 {
            compatible = "zmk,input-split";
            reg = <1>;
            status = "disabled";
        };
    };

    touchpad_listener: touchpad_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&touchpad_split>;
        input-processors = <&zip_xy_swap_mapper &zip_xy_scaler 1 CURSOR_DIVISOR>;

        scroll_override {
            layers = <RAISE LOWER>;
            input-processors = <
                &zip_xy_swap_mapper
                &zip_xy_to_scroll_mapper
                &zip_scroll_transform INPUT_TRANSFORM_Y_INVERT
                &zip_scroll_scaler 1 SCROLL_DIVISOR
            >;
        };

snipe_override {
            layers = <SNIPE_LAYER>;
            input-processors = <&zip_xy_swap_mapper &zip_xy_scaler 1 SNIPE_DIVISOR>;
        };
    };

    touchpad_right_listener: touchpad_right_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&touchpad_right_split>;
        input-processors = <&zip_xy_swap_mapper &zip_xy_scaler 1 CURSOR_DIVISOR>;

        scroll_override {
            layers = <RAISE LOWER>;
            input-processors = <
                &zip_xy_swap_mapper
                &zip_xy_to_scroll_mapper
                &zip_scroll_transform INPUT_TRANSFORM_Y_INVERT
                &zip_scroll_scaler 1 SCROLL_DIVISOR
            >;
        };

        snipe_override {
            layers = <SNIPE_LAYER>;
            input-processors = <&zip_xy_swap_mapper &zip_xy_scaler 1 SNIPE_DIVISOR>;
        };
    };
};
