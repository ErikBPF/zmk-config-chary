#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/outputs.h>
#include "tps43_parameters.h"

// Physical layout (9 cols × 5 rows, 43 keys):
//
//  Row 0:  Q   W   E   R   T   Y   U   I   O
//  Row 1:  A   S   D   F   G   H   J   K   L
//  Row 2:  Z   X   C   V   B   N   M   ,   .
//  Row 3:  `   P   ;   '   [   ]   \   =   -
//  Row 4:      LCK GUI ⌫L  SPC ⌫   ⌫R  RCK
//               (thumb cluster — cols 1-7)

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            require-prior-idle-ms = <125>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <240>;
            quick-tap-ms = <150>;
            bindings = <&mo>, <&kp>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <RAISE LOWER>;
            then-layer = <MULTI>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            label = "Base";
            bindings = <
&kp Q        &kp W         &kp E        &kp R         &kp T         &kp Y        &kp U           &kp I        &kp O
&hm RALT A   &hm LALT S    &hm LCTRL D  &hm LSHIFT F  &hm LMETA G   &hm RMETA H  &hm RSHIFT J    &hm RCTRL K  &hm RALT L
&kp Z        &kp X         &kp C        &kp V         &kp B         &hm N1 N     &hm N2 M        &hm N3 COMMA &kp DOT
&none        &kp P         &kp SEMI     &kp SQT       &kp LBKT      &kp RBKT     &kp BSLH        &kp EQUAL    &kp MINUS
             &mkp LCLK     &kp LGUI     &lt LOWER DEL &kp SPACE     &kp BSPC     &lt RAISE RET   &mkp RCLK
            >;
        };

        raise_layer {
            label = "Raise";
            bindings = <
&kp ESC   &kp F12      &kp F11       &kp F10        &kp F9          &kp N7        &kp N8         &kp N9        &kp N0
&trans    &hm LALT F8  &hm LCTRL F7  &hm LSHIFT F6  &hm LMETA F5    &hm LMETA N4  &hm LSHIFT N5  &hm LCTRL N6  &hm LALT MINUS
&trans    &kp F4       &kp F3        &kp F2         &kp F1          &kp N1        &kp N2         &kp N3        &trans
&trans    &kp FSLH     &trans        &trans         &trans          &trans        &trans         &kp STAR      &trans
          &trans       &trans        &trans         &trans          &trans        &trans         &trans
            >;
        };

        lower_layer {
            label = "Lower";
            bindings = <
&kp ESC  &trans   &trans   &trans   &trans   &trans          &trans           &kp LBKT      &kp RBKT
&trans   &trans   &trans   &trans   &trans   &hm LMETA LEFT  &hm LSHIFT DOWN  &hm LCTRL UP  &hm LALT RIGHT
&trans   &trans   &trans   &trans   &trans   &kp TAB         &kp HOME         &kp END       &kp PG_UP
&trans   &trans   &trans   &trans   &trans   &trans          &trans           &kp PG_DN     &kp GRAVE
         &trans   &trans   &trans   &trans   &trans          &trans           &trans
            >;
        };

        multi_layer {
            label = "Multi";
            bindings = <
&kp ESC     &kp C_BRI_DN     &kp C_BRI_UP      &kp C_VOL_DN             &kp C_VOL_UP      &trans  &trans  &trans  &trans
&trans      &hm LALT C_MUTE  &hm LCTRL C_PREV  &hm LSHIFT C_PLAY_PAUSE  &hm LMETA C_NEXT  &trans  &trans  &trans  &trans
&bt BT_CLR  &bt BT_SEL 0     &bt BT_SEL 1      &bt BT_SEL 2             &bt BT_SEL 3      &trans  &trans  &trans  &trans
&trans      &trans           &trans            &trans                   &trans            &trans  &trans  &trans  &trans
            &trans           &trans            &trans                   &trans            &trans  &trans  &trans
            >;
        };

        mouse_layer {
            label = "Mouse";
            bindings = <
&trans      &trans  &trans  &trans     &trans    &trans     &trans  &trans  &trans
&trans      &trans  &trans  &trans     &trans    &trans     &trans  &trans  &trans
&mkp MCLK   &trans  &trans  &trans     &trans    &trans     &trans  &trans  &mkp LCLK
&trans      &trans  &trans  &trans     &trans    &trans     &trans  &trans  &trans
            &mkp LCLK  &trans  &mkp RCLK  &kp SPACE  &trans  &trans  &trans
            >;
        };

        snipe_layer {
            label = "Snipe";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
